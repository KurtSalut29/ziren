# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# APKs dropped in public/ for ad-hoc device testing via the tunnel — see
# scripts/start-unified-tunnel.ps1. Rebuilt per session, never a release
# artifact worth tracking, and too large to want in history by accident.
/public/*.apk

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# A production build made alongside the dev server (see next.config.ts)
/.next-prod/
