# ============================================================
# Ziren Monorepo — Root .gitignore
# ============================================================

# ----- Secrets & environment variables (NEVER commit these) -----
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.p12
*.jks
service_account*.json
google-services.json
GoogleService-Info.plist

# ----- OS cruft -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor / IDE -----
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.suo
*.user
*.swp
*.swo
*~

# ----- Python / FastAPI (ziren_backend) -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ----- Node / Next.js (ziren_dashboard) -----
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ----- Flutter / Dart (ziren_mobile) -----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.class
*.log
*.pyc
app.*.symbols
app.*.map.json

# ----- Tile pipeline cache (tools/cache/) -----
# Large OSM PBF and generated MBTiles — never commit these
tools/cache/

# ----- Tile pipeline downloads (data/) -----
# Everything here is fetched or generated by tools/generate_tiles.ps1, which
# runs Planetiler with --download. Re-run that script to rebuild it.
#
# This is 1.4 GB and would have made the first push fail outright: GitHub
# rejects any single file over 100 MB, and two of these are 886 MB and 414 MB.
# Committing them once puts them in history permanently — removing them
# afterwards means rewriting history, on a repo other people may already have.
#
#   data/sources/water-polygons-split-3857.zip   886 MB
#   data/sources/natural_earth_vector.sqlite.zip 414 MB
#   data/sources/lake_centerline.shp.zip          78 MB
#
# The pipeline's *output* — ziren_mobile/assets/map/biliran.mbtiles, 2.3 MB —
# IS committed, because the app ships it and regenerating it needs the whole
# 1.4 GB toolchain.
#
# LEADING SLASH, and it matters. Unanchored, `data/` matches a directory of
# that name at ANY depth — which quietly excluded every
# ziren_mobile/lib/features/*/data/ folder, i.e. the entire data layer of the
# Flutter app: auth, incidents, registration, responder, settings and sos
# repositories and services, 19 files. They were invisible to `git status`,
# so they were absent from the checkpoint commit that existed specifically to
# be something to revert to. Anchor to the repo root, which is the only
# `data/` this rule was ever about.
/data/

# ----- Logs -----
logs/
*.log
.worktrees/
