<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native splash — light background, shown while Flutter engine loads -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Applied once Flutter is running.
         Light background ensures the recents/app-switcher thumbnail
         shows a white card, not a dark one. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/zirenBackground</item>
    </style>
</resources>
