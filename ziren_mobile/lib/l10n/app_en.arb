  "@_COMMENT_SAFETY_GUIDE": "Emergency Preparedness / Safety Guide — spec Section 22. Offline reference content.",
  "safetyGuideTitle": "Safety Guide",
  "safetyFireTitle": "Fire",
  "safetyFireStep1": "Get out of the building immediately. Do not go back for belongings.",
  "safetyFireStep2": "If there is smoke, get low and crawl to the exit.",
  "safetyFireStep3": "Do not use the elevator — stairs only.",
  "safetyFireStep4": "Touch the doorknob with the back of your hand before opening it — if it is hot, do not open it.",
  "safetyFireStep5": "Once outside, call the BFP right away or report using Ziren.",
  "safetyFireStep6": "Do not go back inside until it has been declared safe.",
  "safetyEarthquakeTitle": "Earthquake",
  "safetyEarthquakeStep1": "Duck, Cover, Hold — drop down, take cover under a sturdy table, and hold on.",
  "safetyEarthquakeStep2": "Stay away from windows, glass, and heavy furniture.",
  "safetyEarthquakeStep3": "If outdoors, move away from buildings, posts, and power lines.",
  "safetyEarthquakeStep4": "If driving, pull over to a safe spot and stay inside the vehicle.",
  "safetyEarthquakeStep5": "After the shaking stops, be ready for aftershocks.",
  "safetyEarthquakeStep6": "Check your surroundings for damaged gas or power lines before moving.",
  "safetyFloodTitle": "Flood",
  "safetyFloodStep1": "Move to higher ground immediately if your barangay is under a flood warning.",
  "safetyFloodStep2": "Avoid walking or driving through floodwater — six inches of water can knock a person down.",
  "safetyFloodStep3": "Turn off electrical appliances and switch off the main breaker if there is still time.",
  "safetyFloodStep4": "Keep important documents in a waterproof container.",
  "safetyFloodStep5": "Follow MDRRMO's instructions on evacuation.",
  "safetyFloodStep6": "Do not drink floodwater or tap water until it has been declared safe.",
  "safetyTyphoonTitle": "Typhoon",
  "safetyTyphoonStep1": "Watch PAGASA advisories and announcements from Ziren.",
  "safetyTyphoonStep2": "Prepare an emergency kit: water, food, flashlight, first aid, and a power bank.",
  "safetyTyphoonStep3": "Secure or bring inside anything that could be blown away by the wind.",
  "safetyTyphoonStep4": "Stay indoors unless told to evacuate.",
  "safetyTyphoonStep5": "Stay away from trees and power poles during strong winds.",
  "safetyTyphoonStep6": "Know the location of the nearest evacuation center before the typhoon arrives.",
  "safetyRoadAccidentTitle": "Road Accident",
  "safetyRoadAccidentStep1": "Make sure you are safe first before helping others.",
  "safetyRoadAccidentStep2": "Turn on hazard/warning lights and set up a marker if you have one.",
  "safetyRoadAccidentStep3": "Do not move the victim unless there is immediate danger (e.g. fire).",
  "safetyRoadAccidentStep4": "Call the PNP and/or MDRRMO right away, or report using Ziren.",
  "safetyRoadAccidentStep5": "Monitor the victim's breathing and pulse while waiting for help.",
  "safetyRoadAccidentStep6": "If there is bleeding, apply pressure with a clean cloth.",
  "safetyMedicalTitle": "Medical Emergency",
  "safetyMedicalStep1": "Check if the patient is still conscious and breathing normally.",
  "safetyMedicalStep2": "Call for help right away — do not wait for the situation to get worse.",
  "safetyMedicalStep3": "If not breathing and unconscious, start CPR if you know how.",
  "safetyMedicalStep4": "Do not give food or drink to someone having trouble breathing or who is unconscious.",
  "safetyMedicalStep5": "Keep the patient calm and comfortable while waiting.",
  "safetyMedicalStep6": "Prepare the patient's information (age, condition, medication) for the responder.",
  "safetyCrimeTitle": "Crime",
  "safetyCrimeStep1": "Prioritize your own safety — move away from danger if you can.",
  "safetyCrimeStep2": "Do not touch or disturb the crime scene if it is safe to move away.",
  "safetyCrimeStep3": "Call the PNP right away, or report using Ziren.",
  "safetyCrimeStep4": "Note the details: appearance, plate number, direction — if you can safely do so.",
  "safetyCrimeStep5": "Stay in a safe place until the responder arrives.",
  "safetyCrimeStep6": "Follow the police's instructions once they arrive at the scene.",
