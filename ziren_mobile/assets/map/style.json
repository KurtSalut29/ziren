{
  "version": 8,
  "name": "Biliran OSM",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "biliran": {
      "type": "vector",
      "tiles": ["http://localhost:7654/tiles/{z}/{x}/{y}"],
      "minzoom": 9,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#e8e0d8" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "biliran",
      "source-layer": "water",
      "paint": { "fill-color": "#a8c8e8" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "biliran",
      "source-layer": "landuse",
      "paint": { "fill-color": "#d4e8c8", "fill-opacity": 0.6 }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "biliran",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": { "line-color": "#ffffff", "line-width": 1.5 }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "biliran",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk"],
      "paint": { "line-color": "#ffffff", "line-width": 3 }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "biliran",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Regular"],
        "text-size": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
