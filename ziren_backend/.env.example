# ============================================================
# ziren_backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# App
ENVIRONMENT=development
SECRET_KEY=<generate this — see below>

# Supabase (use SERVICE ROLE key — server-side only, never sent to client)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key: Supabase > Project Settings > API>

# Claude API — ResQ Chat (Phase 8)
CLAUDE_API_KEY=

# CORS
CORS_ORIGINS_RAW=http://localhost:3000

# Where emailed links (invite / password reset) send the recipient.
# Must be reachable BY THE DEVICE THAT OPENS THE EMAIL — "localhost" resolves
# to the phone itself when the mail is read on a phone, which fails with
# ERR_CONNECTION_REFUSED. For on-device testing use the dev machine's LAN
# address, e.g. http://192.168.1.20:3000, keep that origin in
# CORS_ORIGINS_RAW, and add it to Supabase > Authentication >
# URL Configuration > Redirect URLs or Supabase will ignore it.
DASHBOARD_BASE_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_INCIDENT_SUBMIT=20/minute